@using Microsoft.AspNetCore.Server.Kestrel.Core
@model IEnumerable<VarsityNexusApp.Models.UserModel>

@if (Model.Count() == 0)
{
    <p class="text-error">No user matched your search query!</p>
}
else
{
    foreach (var user in Model)
    {

        <div class="search-user">
    <div class="title-container">
        <div class="user-pics">
            @if (user.PhotoUrl == "")
                    {
                        <img src="https://saiuniversity.edu.in/wp-content/uploads/2021/02/default-img.jpg" alt="@user.Username[0]">
                    }
                    else
                    {
                        <img src="@user.PhotoUrl" alt="@user.Username[0]">
                    }
                </div>
                <div class="usernames">
                    <p class="display-name">@user.DisplayName</p>

                    <p class="username">@user.Username</p>
                </div>

            </div>
            <div class="view-btn"><a href="#">View</a></div>
        </div>
    }
}