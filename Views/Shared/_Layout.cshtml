<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | Varsity Nexus</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/style.css">
    <link rel="stylesheet" href="~/css/all.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <script src ="~/js/script.js"></script>
    
</head>

<body>
    <div class="main-flex-container">
        <div class="left-flex-container ">
            <div class="nav-logo"><img src="~/img/logo.png" alt="nexus_logo"></div>
            <div class="nav-links">
                <ul>
                    <li class="nav-items"><a id="Home" asp-area="" asp-controller="Home" asp-action="Index"><i
                                class="fas fa-home"></i> Home</a></li>
                    <li class="nav-items"><a id="Home" asp-area="" asp-controller="Home" asp-action="Explore"><i
                                class="fas fa-hashtag"></i> Explore</a></li>
                    <li class="nav-items"><a id="Home" asp-area="" asp-controller="Home" asp-action="Notifications"><i
                                class="far fa-bell"></i> Notifications</a></li>
                    <li class="nav-items"><a id="Home" asp-area="" asp-controller="Home" asp-action="Messages"><i
                                class="fas fa-inbox"></i> Message</a></li>
                    <li class="nav-items"><a id="Home" asp-area="" asp-controller="Home" asp-action="Profile"><i
                                class="far fa-user"></i> Profile</a></li>
                </ul>
            </div>

            <div id="profile-display" class="profile-box">
            </div>
        </div>
        <button class="chatbot-toggler">
            <span class="material-symbols-rounded">mode_comment</span>
            <span class="material-symbols-outlined">close</span>
        </button>
        <div class="chatbot">
            <header>
                <h2>Chatbot</h2>
                <span class="close-btn material-symbols-outlined">close</span>
            </header>
            <ul class="chatbox">
                <li class="chat incoming">
                    <span class="material-symbols-outlined">smart_toy</span>
                    <p>Hi there 👋<br>How can I help you today?</p>
                </li>
            </ul>
            <div class="chat-input">
                <textarea placeholder="Enter a message..." spellcheck="false" required></textarea>
                <span id="send-btn" class="material-symbols-rounded">send</span>
            </div>
        </div>


        @RenderBody()


        <div class="right-flex-container">

            @using (Html.AjaxBeginForm("Search", "Partials", FormMethod.Post, new AjaxOptions
             {
                 InsertionMode = InsertionMode.Replace,
                 HttpMethod = "POST",
                 UpdateTargetId = "search-results"
             }))

            {

                <div class="search-container">
                    <div> @Html.TextBox("query", null, new { placeholder = "Search For Users", @class = "search-input" })
                    </div>
                    <button type="submit" class="search-btn"><i class="fas fa-search"></i></button>
                </div>

            }
            <div id="search-results" class="search-results"
                data-url="@Url.Action(action: "Search", controller: "Home")">
            </div>


            <div class="follow">
                <h2 class="header">Follow Suggest</h2>
                <div id="followsuggest"></div>
            </div>

            <div class="right-footer">
                <div class="footer-links">
                    <a href="#" class="sub-text">Terms</a>
                    <a href="#" class="sub-text">Privacy policy</a>
                    <a href="#" class="sub-text">Ads info</a>
                </div>
                <div class="footer-copyright">
                    <p class="sub-text">&copy; 2023 Varsity Nexus</p>
                </div>

            </div>

        </div>

    </div>

    <script>
        $(document).ready(function () {
            (function () {
                var url = $("#search-results").data("url");
                $("#search-results").load(url);
            })();
        });
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    @Html.RenderUnobtrusiveAjaxScript()
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        $('#profile-display').load("/Partials/UserProfile");
        $('#followsuggest').load("/Partials/FollowSuggest");
    </script>

    @if (ViewData["Active"] != null)
    {
        <script type="text/javascript">
            document.getElementById("@ViewData["Active"]").style.color = "#f6703d";
        </script>
    }
</body>

</html>
