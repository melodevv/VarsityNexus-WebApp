<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | Varsity Nexus</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="./css/style.css">
    <link rel="stylesheet" href="./css/all.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/jquery-ajax-unobtrusive/3.2.6/jquery.unobtrusive-ajax.min.js">
</head>

<body>
    <div class="main-flex-container">
        <div class="left-flex-container ">
            <div class="nav-logo"><img src="./img/logo.png" alt="nexus_logo"></div>
            <div class="nav-links">
                <ul>
                    <li class="nav-items current-page"><a href="#"><i class="fas fa-home"></i> Home</a></li>
                    <li class="nav-items"><a href="#"><i class="fas fa-hashtag"></i> Explore</a></li>
                    <li class="nav-items"><a href="#"><i class="far fa-bell"></i> Notifications</a></li>
                    <li class="nav-items"><a href="#"><i class="far fa-user"></i> Profile</a></li>
                </ul>
            </div>

            <div class="profile-box">
                <img src="./img/profile.jpg" alt="profile">
                <div class="profile-link">
                    <a href="" class="full-name">David Herbert</a>
                    <p class="user-name">king.david</p>
                </div>

            </div>
        </div>


        @RenderBody()


        <div class="right-flex-container">

            @using (Html.AjaxBeginForm("Search", "Home", FormMethod.Post, new AjaxOptions
             {
                 InsertionMode = InsertionMode.Replace,
                 HttpMethod = "POST",
                 UpdateTargetId = "search-results"
             }))

            {

                <div class="search-container">
                    <div> @Html.TextBox("query", null, new { placeholder = "Search For Users", @class = "search-input" })
                    </div>
                    <button type="submit" class="search-btn"><i class="fas fa-search"></i></button>
                </div>

            }
            <div id="search-results" class="search-results"
                data-url="@Url.Action(action: "Search", controller: "Home")">
            </div>


            <div class="follow">
                <h2 class="header">Follow Suggest</h2>
                <div class="follow-user">
                    <div class="title-container">
                        <div class="user-pics">
                            <img src="./img/nsfas.jpg" alt="user6">
                        </div>
                        <div class="usernames">
                            <p class="display-name">Nsfas</p>

                            <p class="user-name">nsfas.org.za</p>
                        </div>

                    </div>
                    <div class="follow-btn"><a href="#">follow</a></div>
                </div>
            </div>

            <div class="right-footer">
                <div class="footer-links">
                    <a href="#" class="sub-text">Terms</a>
                    <a href="#" class="sub-text">Privacy policy</a>
                    <a href="#" class="sub-text">Ads info</a>
                </div>
                <div class="footer-copyright">
                    <p class="sub-text">&copy; 2023 Varsity Nexus</p>
                </div>

            </div>

        </div>

    </div>

    <script>$(document).ready(function () {
            (function () {
                var url = $("#search-results").data("url");
                $("#search-results").load(url);
            })();
        });
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    @Html.RenderUnobtrusiveAjaxScript()
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
