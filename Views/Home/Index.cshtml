@{
    ViewData["Title"] = "Home";
}

<div class="center-flex-container flex-item">
    <div class="home">
        <h1>Home</h1>
        <i class="fas fa-magic"></i>
    </div>

    <div class="post-create">
        <form action="">
            <div class="form-group-1">
                <img src="./img/profile.jpg" alt="profile-pics">
                <input type="text" placeholder="What's happening?">
            </div>
            <div class="form-group-2">
                <button class="btn" type="submit">Post</button>
            </div>
        </form>

    </div>
    <!-- User Content -->
    <div class="tweets">
        <div class="user-pics"><img src="./img/user3.jpg" alt="user3"></div>
        <div class="user-content-box">
            <div class="user-names">
                <hi class="display-name">Olivia Brent</hi>
                <p class="username">iamolivia</p>
            </div>

            <div class="user-content">
                <p>I am very much in love with UFS it is the best University in Bloem by a mile!</p>
            </div>

            <div class="post-footer">
                <div class="content-icons">
                    <i class="far fa-heart red"></i>
                    <i class="fas fa-retweet green"></i>
                    <i class="far fa-comment blue"></i>
                </div>
                <p class="timestamp">58mins</p>
            </div>

        </div>
    </div>
</div>