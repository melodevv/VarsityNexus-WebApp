@model IEnumerable<VarsityNexusApp.Models.PostModel>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Explore";
}

<div class="center-flex-container flex-item">
    <div class="home">
        <h1>Explore</h1>
        <i class="fas fa-magic"></i>
    </div>

    <!-- User Content -->
    @if (Model.Count() == 0)
    {
        <p>NOT POST AT THE MOMENT</p>
    }
    else
    {
        @foreach (var post in Model)
        {
            <div class="post">
                <div class="post-user">
                    @if (post.PostOwner.PhotoUrl == "")
                    {
                        <img src="https://saiuniversity.edu.in/wp-content/uploads/2021/02/default-img.jpg"
                            alt="@post.PostOwner.Username[0]">
                    }
                    else
                    {
                        <img src="@post.PostOwner.PhotoUrl" alt="@post.PostOwner.Username[0]">
                    }
                </div>
                <div class="user-content-box">
                    <div class="top-bar">
                        <p class="display-name">@post.PostOwner.DisplayName</p>
                        <p class="username">@post.PostOwner.Username</p>
                    </div>

                    <div class="user-content">
                        <p>@post.Description</p>
                    </div>

                    <div class="post-footer">
                        <div class="content-icons">
                            <i class="far fa-heart red"></i>
                            <i class="fas fa-retweet green"></i>
                            <i class="far fa-comment blue"></i>
                        </div>
                        <p class="timestamp">@post.Timestamp.ToDateTime()</p>
                    </div>

                </div>
            </div>
        }
    }
</div>