<form asp-action="Login" id="login-form" class="auth-form">
    <div class="auth-form__header">
        <h1>Sign In<span class="period">.</span></h1>
        <p>
            Don't have an account?
            <a asp-action="Register" id="sign-up-btn" type="button">Register</a>
        </p>
    </div>
    <div class="text-danger">@ViewBag.Exception</div>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="Email" class="control-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Password" class="control-label"></label>
        <input asp-for="Password" class="form-control" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <div class="auth-form__footer">
        <button type="submit" value="Create">Login</button>
        <p>
            Forgot your password?
            <button asp-action="ForgotPassword" id="forgot-pw-btn" type="button">Click here</button>
        </p>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
