@model VarsityNexusApp.Models.ForgotPasswordModel

@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "ForgotPassword";
}

<form asp-action="ForgotPassword" id="forgot-pw-form" class="auth-form">
    <div class="auth-form__header">
        <h1>Reset your password</h1>
        <p>
            Enter your email and we'll send you a secure link to reset your
            password
        </p>
    </div>
    @if(ViewBag.Exception != null)
    {
        <div class="text-danger" style="padding-bottom: 10px">@ViewBag.Exception</div>
    }
    @if(ViewBag.Success != null){
        <div class="text-success" style="padding-bottom: 10px">@ViewBag.Success</div>
    }
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="Email" class="control-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="auth-form__footer">
        <button type="submit" value="Create">Login</button>
        <p>
            Ready to Login?
            <a asp-action="Login" id="forgot-pw-btn" type="button">Click here</a>
        </p>
    </div>
</form>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
